# Rust / Cargo
target
Cargo.lock.orig

# Node
node_modules
npm-debug.log*

# Cloudflare Wrangler
.wrangler
wrangler-state
build

# tul-cv-wasm build outputs (regenerated by `make cv-wasm`)
# The wasm crates are workspace members, so their artifacts land in the
# shared root target/ dir (already ignored above).
tul-cv-wasm/pkg
tul-cv-wasm/office/pkg

# WASM assets embedded in the worker — generated by `make cv-wasm`
src/html/tul_cv_wasm.js
src/html/tul_cv_wasm_bg.wasm
src/html/tul_cv_office_wasm.js
src/html/tul_cv_office_wasm_bg.wasm
